# Selara marketing site — copy to .env.local and fill before launch.
# Primary CTAs (nav, hero, CTASection) use NEXT_PUBLIC_BETA_URL when set.

# Required for launch: public TestFlight link (https://testflight.apple.com/join/...)
NEXT_PUBLIC_BETA_URL=

# Site URL for metadata, sitemap, OG tags
NEXT_PUBLIC_SITE_URL=https://selara.app

# Support email shown in footer
NEXT_PUBLIC_SUPPORT_EMAIL=info@selaraillc.com

# Stripe checkout URLs (optional — fall back to /download when unset)
NEXT_PUBLIC_STRIPE_SELECT_URL=
NEXT_PUBLIC_STRIPE_PREMIUM_URL=
NEXT_PUBLIC_STRIPE_PINNACLE_URL=

# Social links (optional)
NEXT_PUBLIC_X_URL=https://x.com/ZacharyCoh97302

# Privacy-friendly analytics (optional — loads only after cookie consent)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=selara.app

# Error monitoring (optional — loads only after cookie consent)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=production

# Lead magnet email capture webhook (Formspree, ConvertKit, Buttondown, etc.)
# POST JSON: { email, firstName?, source, tags }. Unset in dev unlocks guide without forwarding.
LEAD_MAGNET_WEBHOOK_URL=

# Beta signup webhook (app/backend → ESP). Triggers welcome series in docs/email-sequence-process.md.
# POST JSON: { email, firstName?, source: "beta-signup", tags: ["beta-user","open-beta"], signedUpAt? }
# Wired outside this repo — document URL here for ops; copy lives in lib/email-sequences.ts.
BETA_SIGNUP_WEBHOOK_URL=
