# Selara marketing site — copy to .env.local and fill before launch.
# Primary CTAs (nav, hero, CTASection) use NEXT_PUBLIC_BETA_URL when set.

# Required for launch: public TestFlight link (https://testflight.apple.com/join/...)
NEXT_PUBLIC_BETA_URL=

# Site URL for metadata, sitemap, OG tags
NEXT_PUBLIC_SITE_URL=https://selara.app

# Support email shown in footer
NEXT_PUBLIC_SUPPORT_EMAIL=info@selaraillc.com

# Stripe checkout URLs (optional — fall back to /download when unset)
NEXT_PUBLIC_STRIPE_SELECT_URL=
NEXT_PUBLIC_STRIPE_PREMIUM_URL=
NEXT_PUBLIC_STRIPE_PINNACLE_URL=

# Social links (optional)
NEXT_PUBLIC_X_URL=https://x.com/selaraapp
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/selaraapp
